<jasperReport name="certificado_licencia" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="434366db-8f98-43d1-9f63-c6ca057c0efd">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="ID_LICENCIA" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT
  l.numero            AS numero_licencia,
  l.fecha_emision     AS fecha_emision,
  l.estado            AS estado_licencia,
  e.numero            AS numero_expediente,
  e.nombre_comercial  AS nombre_comercial,
  e.actividad         AS actividad,
  e.tipo_persona      AS tipo_persona,
  e.ruc               AS ruc,
  e.razon_social      AS razon_social,
  e.modalidad         AS modalidad,
  e.fecha_fin_vigencia AS fecha_fin_vigencia,
  g.codigo_ciiu       AS codigo_ciiu,
  g.nombre            AS giro,
  g.nivel_riesgo      AS nivel_riesgo,
  CONCAT(es.via_tipo, ' ', es.via_nombre, ' ', es.numero,
         IF(es.interior <> '', CONCAT(' Int. ', es.interior), '')) AS direccion,
  es.area_m2          AS area_m2,
  z.codigo            AS zona_codigo,
  z.nombre            AS zona,
  CONCAT(s.nombres, ' ', s.apellidos) AS titular,
  s.dni               AS dni_titular,
  CONCAT(f.nombres, ' ', f.apellidos) AS firmante
FROM licencia l
JOIN expediente e       ON e.id_expediente = l.id_expediente
JOIN establecimiento es ON es.id_establecimiento = e.id_establecimiento
JOIN zona z             ON z.id_zona = es.id_zona
JOIN giro g             ON g.id_giro = e.id_giro
JOIN usuario s          ON s.id_usuario = e.id_solicitante
JOIN usuario f          ON f.id_usuario = l.id_firmante
WHERE l.id_licencia = $P{ID_LICENCIA}]]></query>
